# ===================================
# DATABASE CONFIGURATION
# ===================================
# Two local databases, kept deliberately separate:
#
#   fop_dev   <- this file / .env   Manual testing. Your data persists.
#   fop_test  <- .env.test          Jest only. Wiped at the start of every suite.
#
# jest.config.js loads .env.test before anything imports db.js, and dotenv never
# overwrites a variable that is already set, so .env.test always wins inside tests.
# That means the value below cannot redirect the test suite.
#
# Never point this at fop_test: `npm test` drops and recreates its tables, so you
# would lose your dev data on every test run.
#
# First-time setup:
#   psql -h localhost -U postgres -c "CREATE DATABASE fop_dev"
#   psql -h localhost -U postgres -c "CREATE DATABASE fop_test"
#   npm run setup && npm run seed    # builds fop_dev  (this file)
#   npm run db:setup:test            # builds fop_test (.env.test)
#
# Day to day:
#   npm run db:which     # print which database .env currently points at
#   npm run db:refresh   # reset + setup + seed, in one step
#
# `reset` and `seed` refuse to run unless DATABASE_URL points at localhost.
# `seed` inserts admin accounts whose password is published in TEST_CREDENTIALS.md,
# so it must never reach a real database. To override deliberately:
#   ALLOW_REMOTE_DB=1 npm run <script>
#
# Replace 'YOUR_PASSWORD' with your PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fop_dev"

# Production database (Render or other hosting)
# Uncomment and use when deploying to production
# DATABASE_URL="postgresql://username:password@host:port/database_name"

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5001
NODE_ENV=development
# For production deployment, change to:
# NODE_ENV=production

# ===================================
# JWT CONFIGURATION
# ===================================
# Generate secure secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_generated_jwt_secret_here
ADMIN_BACKDOOR_TOKEN=your_generated_admin_token_here

# ===================================
# CLOUDINARY CONFIGURATION (Images)
# ===================================
# Sign up at https://cloudinary.com (free tier available)
# Get credentials from: Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===================================
# CLOUDFLARE R2 CONFIGURATION (Documents)
# ===================================
# Sign up at https://cloudflare.com
# Create R2 bucket and generate API tokens
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# ===================================
# EMAIL CONFIGURATION (NodeMailer)
# ===================================
# OPTION 1: Mailtrap (Recommended for Development)
# Sign up at https://mailtrap.io (free)
# Get credentials from: Email Testing → Inboxes → SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password

# OPTION 2: Gmail (For Production or Testing)
# 1. Enable 2FA on your Google account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the app password below (not your regular password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your_16_character_app_password

# ===================================
# FRONTEND CONFIGURATION
# ===================================
# Local development frontend URL
FRONTEND_URL=http://localhost:5173

# Production frontend URL (update when deploying)
# FRONTEND_URL=https://your-app.vercel.app

# ===================================
# CONTACT FORM
# ===================================
# Email address to receive contact form submissions
CONTACT_RECEIVER_EMAIL=your-email@example.com
